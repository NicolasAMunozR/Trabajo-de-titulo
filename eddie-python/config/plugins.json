{
  "_comentario": "Archivo de configuración de plugins del sistema EDDIE Python.",
  "_nota": "Para activar/desactivar un plugin, cambia 'enabled' a true/false.",
  "plugins": [
    {
      "name": "CameraSensor",
      "class": "hardware.camera_sensor.CameraSensorPlugin",
      "enabled": true,
      "config": {
        "camera_index": 0
      }
    },
    {
      "name": "ImageProcessor",
      "class": "plugins.image_processor_plugin.ImageProcessorPlugin",
      "enabled": true,
      "dependencies": {
        "camera_sensor": "CameraSensor"
      },
      "config": {
        "ocr_language": "spa",
        "tesseract_path": "C:\\Program Files\\Tesseract-OCR\\tesseract.exe",
        "min_confidence": 0.6
      }
    },
    {
      "name": "EyeTracker",
      "class": "hardware.eye_tracker.EyeTrackerPlugin",
      "enabled": false,
      "config": {
        "backend": "auto",
        "gazecloud_url": "ws://127.0.0.1:3000",
        "eyetribe_host": "127.0.0.1",
        "eyetribe_port": 6555,
        "connection_timeout_s": 2.0
      }
    },
    {
      "name": "GesturePlugin",
      "class": "plugins.gesture_plugin.GesturePlugin",
      "enabled": true,
      "dependencies": {
        "camera_sensor": "CameraSensor"
      },
      "config": {
        "detection_method": "opencv_contours"
      }
    },
    {
      "name": "ConsistencyProvider",
      "class": "plugins.consistency_plugin.ConsistencyPlugin",
      "enabled": true,
      "config": {
        "pdf_path": ""
      }
    },
    {
      "name": "WebSearchProvider",
      "class": "plugins.web_search_plugin.WebSearchPlugin",
      "enabled": false,
      "config": {
        "language": "es"
      }
    }
  ]
}
